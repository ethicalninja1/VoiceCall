# Copy to .env and export (or set in your hosting dashboard). Everything is optional.

# --- Server ---
PORT=3000
DATA_DIR=./data                    # SQLite database, photos, backups
ADMIN_USER=admin
# ADMIN_PASSWORD=                  # if unset, a random password is generated on first run (shown once)
DEFAULT_COUNTRY_CODE=91            # used for 10-digit mobile numbers typed without +country code
TRUST_PROXY=true                   # trust CF-Connecting-IP / X-Forwarded-For only from local/private proxies

# --- Verification codes (OTP) at sign-up / password reset. If neither is set, accounts are created unverified. ---
# SMTP_URL=smtps://user:pass@smtp.gmail.com:465      # email codes (needs: npm i nodemailer)
# MAIL_FROM="VoiceCall <no-reply@yourdomain.com>"
# SMS_WEBHOOK_URL=https://your-sms-gateway/send      # POST {"to":"+91...","text":"..."}  (Twilio / MSG91 / Fast2SMS adapter)
# SMS_WEBHOOK_AUTH="Bearer xxxxx"
# REQUIRE_VERIFICATION=off                            # skip OTP even if a channel is configured

# --- Calls over any network ---
# TURN_URL=turn:host:3478,turns:host:443
# TURN_USER=user
# TURN_PASS=pass
# CF_TURN_KEY_ID=...               # Cloudflare Realtime TURN (credentials generated automatically)
# CF_TURN_API_TOKEN=...

# --- Push notifications (rings the phone when the app is closed) ---
# VAPID_SUBJECT=mailto:you@example.com     # keys are generated automatically and stored in the database

# --- Location of IP addresses ---
# GEOIP=off                                # disable IP geolocation
# GEOIP_URL=https://ipwho.is/{ip}

# --- Admin alerts on Telegram (sign-ups, lockouts, reports, bans) ---
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# --- Data retention ---
# MESSAGE_RETENTION_DAYS=0                 # 0 = keep chat messages forever
# EVENT_RETENTION_DAYS=90
